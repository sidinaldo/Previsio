# Previsio — produção. Copie para deploy/.env e preencha. O .env NUNCA vai para o git.
# Gere senhas e chaves com:  openssl rand -base64 48

# Endereço público (sem barra no fim). O Bling volta para ${PREVISIO_URL}/api/bling/callback
PREVISIO_URL=https://previsio.softioconsultoria.com.br

# Banco
POSTGRES_PASSWORD=

# Assina os logins (mínimo 32 caracteres). Trocar derruba todos os logins abertos.
JWT_CHAVE=

# Primeiro administrador (só com o banco vazio). Depois do 1º login, troque a senha e apague ADMIN_SENHA.
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=

# App do Bling da rede padrão (opcional: cada empresa pode ter o seu, cadastrado no painel)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# E-mail de saída (avisos de vencimento, resumo semanal, esqueci a senha). Vazio = não envia.
SMTP_HOST=
SMTP_PORTA=587
SMTP_SSL=false
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
SMTP_NOME_REMETENTE=Previsio

# Backup cifrado no R2. Sem BACKUP_SENHA o backup não roda. Guarde-a fora da VPS: sem ela, nada restaura.
BACKUP_SENHA=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_BACKUP=
R2_PASTA=previsio
# Monitor externo (ex.: healthchecks.io): alerta se o backup parar de chamar
BACKUP_PUSH_URL=

# Limites de memória (a VPS é dividida com a Nexora)
LIMITE_API=1g
LIMITE_DB=1g
LIMITE_WEB=64m
LIMITE_BACKUP=256m
